<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefHeight="700.0" prefWidth="880.0"
            stylesheets="@../css/bon.css"
            fx:controller="com.supermarche.frontend.controllers.AjoutProduitController">

    <children>
        <ScrollPane fitToWidth="true" AnchorPane.topAnchor="0"
                    AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">
            <content>
                <VBox spacing="12" style="-fx-padding: 20;">

                    <Label text="AJOUTER PRODUIT" styleClass="page-title-center"/>

                    <!-- Ligne 1 -->
                    <HBox spacing="10">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Unité :" styleClass="form-label"/>
                            <TextField fx:id="unite" promptText="pièce / kg / L"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Nom * :" styleClass="form-label"/>
                            <TextField fx:id="nom" promptText="Nom du produit"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Marque :" styleClass="form-label"/>
                            <TextField fx:id="marque" promptText="Marque"/>
                        </VBox>
                    </HBox>

                    <!-- Ligne 2 -->
                    <HBox spacing="10">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Famille :" styleClass="form-label"/>
                            <TextField fx:id="famille" promptText="Famille"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Désignation :" styleClass="form-label"/>
                            <TextField fx:id="designation" promptText="Désignation"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Rayonnage :" styleClass="form-label"/>
                            <TextField fx:id="rayonnage" promptText="Rayonnage"/>
                        </VBox>
                    </HBox>

                    <!-- Ligne 3 : Code produit + boutons -->
                    <HBox spacing="10" alignment="BOTTOM_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Code produit (optionnel) :" styleClass="form-label"/>
                            <TextField fx:id="codeproduit" promptText="Laisser vide ou générer"/>
                        </VBox>
                        <Button fx:id="btnGenererCode" onAction="#genererCode"
                                text="🎲 Générer" styleClass="btn-secondary" prefHeight="30"/>
                        <Button fx:id="btnVerifierCode" onAction="#verifierCode"
                                text="🔍 Vérifier" styleClass="btn-secondary" prefHeight="30"/>
                        <Label fx:id="lblEtatCode" text="" styleClass="info-label"/>
                    </HBox>

                    <!-- Ligne 4 -->
                    <HBox spacing="10">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Qté initiale :" styleClass="form-label"/>
                            <TextField fx:id="qteinitiale" promptText="0"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Seuil alerte :" styleClass="form-label"/>
                            <TextField fx:id="qteAlerte" promptText="5"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Jours alerte :" styleClass="form-label"/>
                            <TextField fx:id="joursalerte" promptText="30"/>
                        </VBox>
                    </HBox>

                    <!-- Ligne 5 -->
                    <HBox spacing="10">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Prix achat :" styleClass="form-label"/>
                            <TextField fx:id="prixachat" promptText="0.00"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Prix gros :" styleClass="form-label"/>
                            <TextField fx:id="prixgros" promptText="0.00"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Prix détail :" styleClass="form-label"/>
                            <TextField fx:id="prixdetail" promptText="0.00"/>
                        </VBox>
                    </HBox>

                    <!-- Ligne 6 -->
                    <HBox spacing="10">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="TVA % :" styleClass="form-label"/>
                            <TextField fx:id="tva" promptText="20"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Date péremption :" styleClass="form-label"/>
                            <DatePicker fx:id="dateperemption" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <!-- ⭐ SECTION PHOTO -->
                    <Label text="Photo du produit :" styleClass="form-label"
                           style="-fx-padding: 10 0 0 0;"/>

                    <HBox spacing="20" alignment="CENTER_LEFT">
                        <!-- Aperçu de l'image -->
                        <StackPane style="-fx-border-color: #d0d7de; -fx-border-radius: 6;
                                          -fx-background-color: #fafbfc; -fx-padding: 5;"
                                   prefWidth="220" prefHeight="180">
                            <ImageView fx:id="apercuPhoto"
                                       fitWidth="200" fitHeight="160"
                                       preserveRatio="true"/>
                            <Label fx:id="lblPhotoPlaceholder"
                                   text="Aucune photo"
                                   style="-fx-text-fill: #95a5a6; -fx-font-style: italic;"/>
                        </StackPane>

                        <!-- Boutons -->
                        <VBox spacing="10" alignment="CENTER_LEFT">
                            <Button fx:id="btnAjouterPhoto" onAction="#ajouterPhoto"
                                    text="📷 Ajouter une photo"
                                    styleClass="btn-primary"
                                    prefWidth="180" prefHeight="40"/>
                            <Button fx:id="btnSupprimerPhoto" onAction="#supprimerPhoto"
                                    text="🗑️ Supprimer la photo"
                                    styleClass="btn-danger"
                                    prefWidth="180" prefHeight="40"
                                    disable="true"/>
                            <Label fx:id="lblInfoPhoto" text="" styleClass="info-label"/>
                        </VBox>
                    </HBox>

                    <!-- Boutons finaux -->
                    <HBox alignment="CENTER" spacing="15" style="-fx-padding: 20 0 0 0;">
                        <Button fx:id="btnenregistrer" onAction="#enregistrer"
                                text="💾 ENREGISTRER" styleClass="btn-success-large"/>
                        <Button fx:id="btnannuler" onAction="#annuler"
                                text="ANNULER" styleClass="btn-secondary-large"/>
                    </HBox>

                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>