<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefHeight="400.0" prefWidth="560.0"
            stylesheets="@../css/bon.css"
            fx:controller="com.supermarche.frontend.controllers.ConfirmerPaiementController">

    <children>
        <VBox spacing="15" style="-fx-padding: 25;">

            <!-- Titre -->
            <Label text="💰 Confirmer le paiement"
                   styleClass="page-title-center"/>

            <!-- Info bon -->
            <VBox spacing="5"
                  style="-fx-background-color: #ecf0f1;
                         -fx-padding: 12;
                         -fx-background-radius: 6;">
                <Label fx:id="lblNumeroBon"
                       text="Bon N° —"
                       style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 14px;"/>
                <Label fx:id="lblFournisseur"
                       text="Fournisseur : —"
                       style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
            </VBox>

            <!-- Résumé financier -->
            <VBox spacing="10"
                  style="-fx-background-color: #fafbfc;
                         -fx-padding: 15;
                         -fx-background-radius: 6;
                         -fx-border-color: #e0e0e0;
                         -fx-border-radius: 6;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Total du bon :" styleClass="form-label" prefWidth="160"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTotal" text="0.00 DA"
                           style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 14px;"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Versement initial :" styleClass="form-label" prefWidth="160"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblVersementInitial" text="0.00 DA"
                           style="-fx-text-fill: #3498db; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Reste à payer :" styleClass="form-label" prefWidth="160"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblReste" text="0.00 DA"
                           style="-fx-text-fill: #e74c3c; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                </HBox>
            </VBox>

            <!-- Champ versement -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-padding: 10 0 0 0;">
                <Label text="Versement reçu :" styleClass="form-label" prefWidth="160"/>
                <TextField fx:id="txtVersementRecu"
                           promptText="0.00"
                           prefWidth="180"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <Label text="DA" styleClass="form-label"/>
            </HBox>

            <!-- Message d'erreur -->
            <Label fx:id="lblMessage"
                   text=""
                   styleClass="info-label"
                   wrapText="true"/>

            <!-- Boutons -->
            <HBox alignment="CENTER" spacing="15"
                  style="-fx-padding: 15 0 0 0;">
                <Button fx:id="btnConfirmer" onAction="#confirmer"
                        text="✅ Confirmer"
                        styleClass="btn-success"
                        prefWidth="150" prefHeight="40"/>
                <Button fx:id="btnAnnuler" onAction="#annuler"
                        text="❌ Annuler"
                        styleClass="btn-secondary"
                        prefWidth="150" prefHeight="40"/>
            </HBox>

        </VBox>
    </children>
</AnchorPane>